*.sqlite
*.sqlite3
*.db
*.log

# OTS universal sensitive-data safeguards (2026-11)
# Ignore local secrets and machine-specific configuration at any directory depth.
.env
.env.*
!.env.example
!.env.sample
!.env.template
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
.envrc
.envrc.local
*.local.env
*.secret
*.secrets
*credentials*.json
*secrets*.json
service-account*.json
service_account*.json
client_secret*.json
*.pem
*.key
